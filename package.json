{
  "name": "question-repair-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node tests/yes-no.mjs && node tests/classroom.mjs && node tests/export.mjs",
    "preview": "vite preview",
    "test:emulators": "firebase emulators:exec --only firestore,auth --project demo-question-repair \"node tests/security.mjs && node tests/emulator-browser.mjs\""
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-tools": "^15.30.2",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
